<Page x:Class="RimePPT.Windows.AboutSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel HorizontalAlignment="Stretch" Padding="30,0,30,36" Spacing="16">
  <Expander Style="{StaticResource SettingExpanderStyle}" HorizontalAlignment="Stretch" IsExpanded="False" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/RimePPT-Logo.svg" Width="40" Height="40"/><StackPanel VerticalAlignment="Center"><TextBlock Text="RimePPT" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="雾凇 PPT 助手" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel></StackPanel></Expander.Header><Border Style="{StaticResource SettingCardStyle}" Padding="24"><StackPanel Spacing="16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/RimePPT-Logo.svg" Width="64" Height="64"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="RimePPT" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="雾凇 PPT 助手"/><TextBlock x:Name="VersionText" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel></Grid><TextBlock Text="让课堂讲述更从容。" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="面向 Windows 的 PowerPoint 放映助手。支持原生放映、笔迹批注、翻页动画与浮动工具栏。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/><StackPanel Spacing="8"><TextBlock Text="软件技术栈" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="C# · .NET 10 LTS"/><TextBlock Text="WinUI 3 · Windows App SDK 2.5.1"/><TextBlock Text="Windows 原生 API · PowerPoint COM · Win2D" TextWrapping="Wrap"/><TextBlock Text="System.Text.Json · MSIX"/></StackPanel></StackPanel></Border></Expander>
  <Expander Style="{StaticResource SettingExpanderStyle}" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/MYXMJY-white.png" Width="150" Height="30"/><TextBlock Text="开发者与 MYXMJY" VerticalAlignment="Center"/></StackPanel></Expander.Header><Border Style="{StaticResource SettingCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="ms-appx:///Assets/MYXMJY-white.png" Width="180" Height="36" HorizontalAlignment="Left" Tapped="DeveloperLogo_Tapped"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="官网 · 未完工" IsEnabled="False"/><Button Content="文档 · 未完工" IsEnabled="False"/></StackPanel></Grid></Border></Expander>
  <Border Style="{StaticResource SettingCardStyle}" Padding="16" MinHeight="80"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="项目与官网" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Click="OnGitHub"><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="ms-appx:///Assets/GitHub-Mark-White.svg" Width="18" Height="18"/><TextBlock Text="GitHub"/></StackPanel></Button><Button Style="{StaticResource AccentButtonStyle}" Click="OnWebsite"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE774;"/><TextBlock Text="官网"/></StackPanel></Button></StackPanel></Grid></Border>
  <Border Style="{StaticResource SettingCardStyle}" Padding="16" MinHeight="80"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="问题反馈" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="如果遇到问题、需要反馈或想提交建议，请前往 GitHub Issues。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Click="OnFeedback" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="ms-appx:///Assets/GitHub-Mark-White.svg" Width="18" Height="18"/><TextBlock Text="打开 GitHub 问题反馈"/></StackPanel></Button></Grid></Border>
  <Border Style="{StaticResource SettingCardStyle}" Padding="16" MinHeight="80"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8FA;"/><StackPanel Spacing="4"><TextBlock Text="支持 RimePPT" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="感谢你支持项目的持续维护。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel><Button Grid.Column="1" Click="Support_Click" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE735;"/><TextBlock Text="支持项目"/></StackPanel></Button></Grid></Border>
 </StackPanel></ScrollViewer>
</Page>









