<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RimePPT.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    Title="RimePPT 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="AppTitleBar" Background="Transparent" Padding="16,0,144,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image x:Name="PaneLogo" Width="24" Height="24"/><TextBlock Text="RimePPT 设置" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    <NavigationView Grid.Row="1"
        x:Name="Nav"
        PaneDisplayMode="Auto"
        PaneTitle="设置"
        OpenPaneLength="208"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="720"
        CompactModeThresholdWidth="480"
        IsPaneOpen="True"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        AlwaysShowHeader="False"
        SelectionChanged="OnNavSelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="外观" Tag="appearance" ToolTipService.ToolTip="外观">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="笔迹" Tag="ink" ToolTipService.ToolTip="笔迹">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xEDC6;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="工具栏" Tag="toolbar" ToolTipService.ToolTip="工具栏">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="ClassWidgets 2" Tag="classwidgets" ToolTipService.ToolTip="ClassWidgets 2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="商店更新" Tag="updates" ToolTipService.ToolTip="商店更新"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="调试" Tag="debug" ToolTipService.ToolTip="调试">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="about" ToolTipService.ToolTip="关于">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid x:Name="PageHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="CardBorder" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="SettingDesc" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="Divider" TargetType="Rectangle">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Setter Property="Margin" Value="16,0" />
                </Style>
            </Grid.Resources>
            <StackPanel Margin="24,16,24,20" Spacing="4">
                <TextBlock x:Name="PageTitle" Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PageDescription" Text="选择书写模式，调整主题与启动行为。" Style="{StaticResource SettingDesc}" />
            </StackPanel>

            <!-- ———— 外观 ———— -->
            <Frame x:Name="ContentFrame" Grid.Row="1">
                <Frame.ContentTransitions><TransitionCollection><animation:NavigationThemeTransition /></TransitionCollection></Frame.ContentTransitions>
            </Frame>
            <ScrollViewer x:Name="AppearancePage" Grid.Row="1" Padding="24,0,24,24" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="12">
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                      <StackPanel Spacing="8">
                        <TextBlock Text="书写模式" Style="{StaticResource SettingTitle}"/>
                        <ComboBox x:Name="BackendCombo" HorizontalAlignment="Stretch" SelectionChanged="OnBackendChanged">
                          <ComboBoxItem Content="PowerPoint 原生（COM）"/><ComboBoxItem Content="RimePPT 自研"/>
                        </ComboBox>
                        <TextBlock x:Name="BackendDescription" Text="两套笔与橡皮均保留；原生墨迹由 PowerPoint 管理，自研模式支持多指和撤销。" Style="{StaticResource SettingDesc}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="工具条主题" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="跟随系统，或强制浅色 / 深色" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="140" VerticalAlignment="Center" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="跟随系统" />
                                    <ComboBoxItem Content="浅色" />
                                    <ComboBoxItem Content="深色" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="按钮文字" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="工具条按钮上显示文字标签" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowTextToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="OnShowTextToggled" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="屏幕边距" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="工具条与屏幕边缘的距离（像素）" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <NumberBox x:Name="MarginBox" Grid.Column="1" Width="140" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="OnMarginChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="随放映显示工具条" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="进入幻灯片放映时自动浮出工具条" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoShowToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="OnAutoShowToggled" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="登录 Windows 后自动运行并驻留托盘" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="OnStartupToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ———— 笔迹 ———— -->
            <ScrollViewer x:Name="InkPage" Grid.Row="1" Padding="24,0,24,24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="12">
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="智能图形整理" Style="{StaticResource SettingTitle}"/><TextBlock Text="自研模式下，画完直线、圆或矩形后按住停顿约 0.6 秒；继续移动则保持自由书写。" Style="{StaticResource SettingDesc}"/></StackPanel>
                            <ToggleSwitch x:Name="SmartShapesToggle" Grid.Column="1" OnContent="" OffContent="" AutomationProperties.Name="智能图形整理" Toggled="OnSmartShapesToggled" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="课堂板书回顾" Style="{StaticResource SettingTitle}"/><TextBlock Text="放映结束前，将有自研批注的页面导出为“幻灯片＋笔迹”PNG 图片及 PDF。也可从工具菜单导出。" Style="{StaticResource SettingDesc}"/></StackPanel>
                            <Button Grid.Column="1" Content="导出板书" Click="OnExportBoard" VerticalAlignment="Center" MinHeight="40"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="16,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="翻页笔迹动画" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="适用于 RimePPT 自研笔迹，可在“外观 → 书写模式”中选择。PowerPoint 原生笔迹由 Office 绘制。" Style="{StaticResource SettingDesc}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Padding="16,12" MinHeight="60" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="动画样式" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="渐隐渐显，或沿每笔的起点到终点重新书写" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <ComboBox x:Name="InkAnimationCombo" AutomationProperties.Name="笔迹动画样式" Grid.Column="1" Width="180" VerticalAlignment="Center" SelectionChanged="OnInkAnimationChanged">
                                    <ComboBoxItem Content="关闭动画" /><ComboBoxItem Content="渐隐渐显" /><ComboBoxItem Content="按书写顺序重播" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="淡入淡出时长" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="100–1000 毫秒；重播模式下用于上一页笔迹淡出" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <NumberBox x:Name="InkFadeDurationBox" AutomationProperties.Name="淡入淡出时长（毫秒）" Grid.Column="1" Width="140" Minimum="100" Maximum="1000" SmallChange="20" LargeChange="100" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="OnInkDurationChanged" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="书写重播时长" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="300–4000 毫秒，控制当前页面全部笔迹的重播速度" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <NumberBox x:Name="InkReplayDurationBox" AutomationProperties.Name="书写重播时长（毫秒）" Grid.Column="1" Width="140" Minimum="300" Maximum="4000" SmallChange="100" LargeChange="500" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" ValueChanged="OnInkDurationChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="翻页不会修改或删除笔迹。动画中开始书写、擦除或撤销时会立即显示完整笔迹；Windows 关闭动画效果时直接显示。" Style="{StaticResource SettingDesc}" Margin="16,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ———— 工具栏 ———— -->
            <ScrollViewer x:Name="ToolbarPage" Grid.Row="1" Padding="24,0,24,24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="12">

                    <!-- 显示区域：屏幕示意图选择器 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Spacing="4">
                                <TextBlock Text="显示区域" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="点击屏幕示意图上的区域，显示或隐藏对应工具条" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" MaxWidth="420" Margin="16,12"><Border Width="320" Height="180"
                                    CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <ToggleButton x:Name="ZoneLeftRail" Tag="LeftRail" Click="OnZoneToggled"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                                  ToolTipService.ToolTip="左栏：翻页 · 批注 · 橡皮 · 工具 · 退出">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                                            <TextBlock Text="左栏" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ZoneRightRail" Tag="RightRail" Click="OnZoneToggled"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  ToolTipService.ToolTip="右栏：翻页 · 批注 · 橡皮 · 工具 · 退出">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                                            <TextBlock Text="右栏" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ZoneBottomLeft" Tag="BottomLeft" Click="OnZoneToggled"
                                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                                                  ToolTipService.ToolTip="底左：仅上一页 / 下一页">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                                            <TextBlock Text="底左" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ZoneBottomCenter" Tag="BottomCenter" Click="OnZoneToggled"
                                                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                                  ToolTipService.ToolTip="底中：批注 · 橡皮 · 工具 · 退出">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                            <TextBlock Text="底中" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ZoneBottomRight" Tag="BottomRight" Click="OnZoneToggled"
                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                  ToolTipService.ToolTip="底右：仅上一页 / 下一页">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                                            <TextBlock Text="底右" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            </Viewbox><TextBlock x:Name="LayoutWarning" Padding="16,0,16,12"
                                       Text="当前未选择任何工具条区域，放映时将没有工具条"
                                       Style="{StaticResource SettingDesc}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 实时预览 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="实时预览" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="在主显示器按当前选择实际浮出工具条，切换上方选择立即重建" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <Button x:Name="PreviewButton" Grid.Column="1" Content="启动预览" VerticalAlignment="Center" Click="OnPreviewToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ———— 调试 ———— -->
            <ScrollViewer x:Name="DebugPage" Grid.Row="1" Padding="24,0,24,24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="12">
                    <Border Style="{StaticResource CardBorder}" Padding="16,12">
                        <Grid MinHeight="60" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="工具栏使用引导" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="重置后，在实际放映或模拟工具栏的按钮旁重新展示提示" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="重置引导会话" MinHeight="44" VerticalAlignment="Center" Click="OnResetOnboarding" />
                        </Grid>
                    </Border>
                    <InfoBar x:Name="OnboardingResetInfo" IsOpen="False" IsClosable="True" />
                    <Border Style="{StaticResource CardBorder}" Padding="16"><StackPanel Spacing="12">
                        <TextBlock Text="再次查看指南" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="放映或模拟放映时，可再次查看四步入门或完整导览。不会清除已有科目的引导记录。" Style="{StaticResource SettingDesc}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查看入门引导" Click="OnOpenGuide" MinHeight="40"/>
                            <Button Content="查看完整指南" Tag="complete" Click="OnOpenGuide" MinHeight="40"/>
                        </StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="模拟放映：双侧竖栏" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="无需 Office 即可验证工具条与批注流程" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动" VerticalAlignment="Center" Click="OnDebugSide" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="模拟放映：底部工具条" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="三段式底部布局" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="启动" VerticalAlignment="Center" Click="OnDebugBottom" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" />
                            <Grid Padding="16,12" MinHeight="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="结束模拟" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="关闭由模拟产生的全部浮窗" Style="{StaticResource SettingDesc}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="结束" VerticalAlignment="Center" Click="OnDebugStop" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ———— 关于 ———— -->
            <ScrollViewer x:Name="ClassWidgetsPage" Grid.Row="1" Padding="24,0,24,24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="12">
                    <Border Style="{StaticResource CardBorder}" Padding="20"><StackPanel Spacing="12">
                        <TextBlock Text="当前课程联动" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <InfoBar x:Name="ClassWidgetsInfo" IsOpen="True" IsClosable="False" Title="正在检查连接"/>
                        <Grid ColumnSpacing="24" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="ClassWidgets 2"/><TextBlock x:Name="ClassWidgetsHostStatus" Grid.Column="1" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="联动插件"/><TextBlock x:Name="ClassWidgetsPluginStatus" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="当前科目"/><TextBlock x:Name="ClassWidgetsSubject" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="最后心跳"/><TextBlock x:Name="ClassWidgetsHeartbeat" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                        <Button Content="刷新连接状态" Click="OnRefreshClassWidgets" HorizontalAlignment="Left" MinHeight="40"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Padding="16"><StackPanel Spacing="8">
                        <TextBlock Text="连接说明" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="状态依据插件每隔约 10 秒写入的心跳判断，本页面每 3 秒刷新。课间没有科目是正常状态。有效心跳代表软件与插件联动正常；缺少心跳时，无法单独确定软件是否运行。" Style="{StaticResource SettingDesc}"/>
                        <TextBlock x:Name="ClassWidgetsDataPath" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource SettingDesc}"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="StoreUpdatePage" Grid.Row="1" Padding="24,0,24,24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Spacing="16">
                    <Border Style="{StaticResource CardBorder}" Padding="24"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
