                    </Grid></Border>
                    <InfoBar x:Name="StoreUpdateInfo" IsOpen="False" IsClosable="True" Severity="Informational"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16"><StackPanel Spacing="8">
