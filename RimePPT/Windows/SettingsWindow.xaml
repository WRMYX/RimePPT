                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Padding="24" Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                <Image x:Name="AboutLogo" Width="64" Height="64" Stretch="Uniform" AutomationProperties.Name="RimePPT 软件 Logo" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="RimePPT" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
