<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RimePPT.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RimePPT"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RimePPT Overlay">

    <!--
        小尺寸不透明 Pill 工具栏，停靠在 PPT 监视器底部居中。
        窗口自身被 SetWindowRgn 裁切为圆角矩形，所以即使根 Grid 是不透明的也不会有黑色矩形。
        黑屏模式：窗口扩展到全屏 + RootGrid 切换为黑色 + 隐藏 ToolbarPill。
    -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SmokeFillColorDefaultBrush}">

        <!-- ══ Pill 工具栏（默认显示）══ -->
        <Border x:Name="ToolbarPill"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="30">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Button Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnPrev_Click" ToolTipService.ToolTip="上一页">
                    <FontIcon Glyph="&#xE76B;" FontSize="18" Foreground="White"/>
                </Button>
                <Button Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnNext_Click" ToolTipService.ToolTip="下一页">
                    <FontIcon Glyph="&#xE76C;" FontSize="18" Foreground="White"/>
                </Button>

                <!-- 页码芯片 -->
                <Border CornerRadius="14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Padding="12,4" MinWidth="64"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TbPageInfo" Text="— / —"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- 计时器芯片（计时启动后才显示） -->
                <Border x:Name="TimerChip" Visibility="Collapsed"
                        CornerRadius="14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE916;" FontSize="11"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbTimer" Text="00:00"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Cascadia Code, Consolas"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 工具菜单 -->
                <Button Style="{StaticResource CircleToolBtnStyle}" ToolTipService.ToolTip="工具">
                    <FontIcon Glyph="&#xE700;" FontSize="18" Foreground="White"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem x:Name="MiTimer" Text="开始计时" Click="BtnTimer_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="黑屏" Click="BtnBlackout_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="设置" Click="BtnSettings_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- 退出 -->
                <Button Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnExit_Click" ToolTipService.ToolTip="退出放映">
                    <FontIcon Glyph="&#xF3B1;" FontSize="18"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 黑屏遮罩（仅黑屏模式可见，铺满已扩展的全屏窗口）══ -->
        <Grid x:Name="BlackoutOverlay"
              Visibility="Collapsed"
              Background="Black"
              Tapped="BlackoutOverlay_Tapped">
            <TextBlock Text="点击任意处恢复"
                       Foreground="{ThemeResource TextFillColorDisabledBrush}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
