<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RimePPT.SidebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="4,8">
        <StackPanel Spacing="2">

            <Button x:Name="BtnPrev" Style="{StaticResource ToolbarBtnStyle}" Click="BtnPrev_Click" ToolTipService.ToolTip="上一页">
                <StackPanel>
                    <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="上一页" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnNext" Style="{StaticResource ToolbarBtnStyle}" Click="BtnNext_Click" ToolTipService.ToolTip="下一页">
                <StackPanel>
                    <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="下一页" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,2"/>

            <Button x:Name="BtnAnnotate" Style="{StaticResource ToolbarBtnStyle}" Click="BtnAnnotate_Click" ToolTipService.ToolTip="画笔批注（ESC 退出）">
                <StackPanel>
                    <FontIcon x:Name="IconAnnotate" Glyph="&#xE70C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="LblAnnotate" Text="画笔" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnEraser" Style="{StaticResource ToolbarBtnStyle}" Click="BtnEraser_Click" ToolTipService.ToolTip="橡皮擦（ESC 退出）">
                <StackPanel>
                    <FontIcon x:Name="IconEraser" Glyph="&#xEDC6;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="橡皮" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnClear" Style="{StaticResource ToolbarBtnStyle}" Click="BtnClear_Click" ToolTipService.ToolTip="清除所有批注">
                <StackPanel>
                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="清除" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,2"/>

            <Button x:Name="BtnTools" Style="{StaticResource ToolbarBtnStyle}" ToolTipService.ToolTip="工具">
                <StackPanel>
                    <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="工具" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="ToolsFlyout" Placement="Right">
                        <MenuFlyoutItem x:Name="MiTimer" Text="开始计时" Click="BtnTimer_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="黑屏" Click="BtnBlackout_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="设置" Click="BtnSettings_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnExit_Click" ToolTipService.ToolTip="退出放映">
                <StackPanel>
                    <FontIcon Glyph="&#xF3B1;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="退出" Style="{StaticResource ToolbarLabelStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</Window>
