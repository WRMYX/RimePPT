<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RimePPT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RimePPT"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RimePPT 设置">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20,24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xEA86;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RimePPT" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="PPT 演示工具栏助手" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Settings content -->
        <ScrollViewer Grid.Row="1" Padding="24,16,24,16">
            <StackPanel Spacing="8">

                <!-- Status card -->
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbStatus" Text="正在监听 PowerPoint 放映…"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Background mode -->
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="后台运行模式" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="选择关闭设置窗口后的运行方式" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>
                        <RadioButton x:Name="RbTray" Content="系统托盘图标（推荐）" GroupName="BgMode"
                                     IsChecked="True" Checked="OnBgModeChanged"/>
                        <RadioButton x:Name="RbBackground" Content="纯后台（无托盘图标）" GroupName="BgMode"
                                     Checked="OnBgModeChanged"/>
                    </StackPanel>
                </Border>

                <!-- Auto-start -->
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="开机自动启动" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows 启动时自动运行 RimePPT" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="TsAutoStart" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="TsAutoStart_Toggled" OnContent="" OffContent=""/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="v1.0  ·  检测到 PowerPoint 放映后自动弹出工具栏"
                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="退出程序" Click="BtnQuit_Click"
                        Background="#22C62828" Foreground="#C62828"
                        BorderBrush="#44C62828" CornerRadius="6" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
