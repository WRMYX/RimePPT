<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RimePPT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RimePPT"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RimePPT">

    <!-- 根容器：黑色全屏背景 -->
    <Grid x:Name="RootGrid" Background="#FF000000">

        <!-- 幻灯片展示区：居中图片 + 批注画布 -->
        <Grid x:Name="SlideArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Image x:Name="SlideImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
            <!-- 批注画布（透明叠加层） -->
            <Canvas x:Name="InkCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="InkCanvas_PointerPressed"
                    PointerMoved="InkCanvas_PointerMoved"
                    PointerReleased="InkCanvas_PointerReleased"
                    PointerCaptureLost="InkCanvas_PointerReleased" />
        </Grid>

        <!-- ══ 左侧浮动工具栏 ══ -->
        <Border x:Name="LeftToolbar"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="12,0,0,0"
                Width="52"
                CornerRadius="10"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="4,8">
            <StackPanel Spacing="4">
                <!-- 上一页 -->
                <Button x:Name="BtnLeftPrev" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnPrev_Click" ToolTipService.ToolTip="上一页">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="上一页" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 下一页 -->
                <Button x:Name="BtnLeftNext" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnNext_Click" ToolTipService.ToolTip="下一页">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="下一页" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 分隔线 -->
                <Rectangle Height="1" Fill="#E0E0E0" Margin="4,2"/>
                <!-- 批注 -->
                <Button x:Name="BtnLeftAnnotate" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnAnnotate_Click" ToolTipService.ToolTip="批注">
                    <StackPanel>
                        <FontIcon Glyph="&#xED63;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="批注" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 橡皮 -->
                <Button x:Name="BtnLeftEraser" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnEraser_Click" ToolTipService.ToolTip="橡皮">
                    <StackPanel>
                        <FontIcon Glyph="&#xED60;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="橡皮" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 分隔线 -->
                <Rectangle Height="1" Fill="#E0E0E0" Margin="4,2"/>
                <!-- 上锁 -->
                <Button x:Name="BtnLeftLock" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnLock_Click" ToolTipService.ToolTip="上锁">
                    <StackPanel>
                        <FontIcon x:Name="IconLeftLock" Glyph="&#xE72E;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="上锁" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 退出 -->
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnExit_Click" ToolTipService.ToolTip="退出">
                    <StackPanel>
                        <FontIcon Glyph="&#xF3B1;" FontSize="16" Foreground="#C62828"/>
                        <TextBlock Text="退出" Style="{StaticResource ToolbarLabelStyle}" Foreground="#C62828"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 右侧浮动工具栏（镜像） ══ -->
        <Border x:Name="RightToolbar"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0,0,12,0"
                Width="52"
                CornerRadius="10"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="4,8">
            <StackPanel Spacing="4">
                <Button x:Name="BtnRightPrev" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnPrev_Click" ToolTipService.ToolTip="上一页">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="上一页" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRightNext" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnNext_Click" ToolTipService.ToolTip="下一页">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="下一页" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Fill="#E0E0E0" Margin="4,2"/>
                <Button x:Name="BtnRightAnnotate" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnAnnotate_Click" ToolTipService.ToolTip="批注">
                    <StackPanel>
                        <FontIcon Glyph="&#xED63;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="批注" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRightEraser" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnEraser_Click" ToolTipService.ToolTip="橡皮">
                    <StackPanel>
                        <FontIcon Glyph="&#xED60;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="橡皮" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Fill="#E0E0E0" Margin="4,2"/>
                <Button x:Name="BtnRightLock" Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnLock_Click" ToolTipService.ToolTip="上锁">
                    <StackPanel>
                        <FontIcon x:Name="IconRightLock" Glyph="&#xE72E;" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock Text="上锁" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}"
                        Click="BtnExit_Click" ToolTipService.ToolTip="退出">
                    <StackPanel>
                        <FontIcon Glyph="&#xF3B1;" FontSize="16" Foreground="#C62828"/>
                        <TextBlock Text="退出" Style="{StaticResource ToolbarLabelStyle}" Foreground="#C62828"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 底部浮动工具栏 ══ -->
        <Border x:Name="BottomToolbar"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                CornerRadius="28"
                Background="#CC1A1A2E"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 上一页 -->
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnPrev_Click" ToolTipService.ToolTip="上一页">
                    <FontIcon Glyph="&#xE76B;" FontSize="18" Foreground="White"/>
                </Button>
                <!-- 下一页 -->
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnNext_Click" ToolTipService.ToolTip="下一页">
                    <FontIcon Glyph="&#xE76C;" FontSize="18" Foreground="White"/>
                </Button>
                <!-- 页码显示 -->
                <Border CornerRadius="16" Background="#33FFFFFF" Padding="12,0" MinWidth="60">
                    <TextBlock x:Name="TbPageInfo" Text="1 / 1"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <!-- 批注 -->
                <Button x:Name="BtnBottomAnnotate" Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnAnnotate_Click" ToolTipService.ToolTip="批注">
                    <FontIcon Glyph="&#xED63;" FontSize="18" Foreground="White"/>
                </Button>
                <!-- 橡皮 -->
                <Button x:Name="BtnBottomEraser" Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnEraser_Click" ToolTipService.ToolTip="橡皮">
                    <FontIcon Glyph="&#xED60;" FontSize="18" Foreground="White"/>
                </Button>
                <!-- 清除批注 -->
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnClearInk_Click" ToolTipService.ToolTip="清除本页批注">
                    <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="#FF8A65"/>
                </Button>
                <!-- 上锁 -->
                <Button x:Name="BtnBottomLock" Style="{StaticResource CircleToolBtnStyle}"
                        Click="BtnLock_Click" ToolTipService.ToolTip="上锁">
                    <FontIcon x:Name="IconBottomLock" Glyph="&#xE72E;" FontSize="18" Foreground="White"/>
                </Button>
                <!-- 打开文件 -->
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnOpenFile_Click" ToolTipService.ToolTip="打开文件">
                    <FontIcon Glyph="&#xE8E5;" FontSize="18" Foreground="White"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 颜色选择浮层 ══ -->
        <Border x:Name="ColorPanel"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,90"
                CornerRadius="20"
                Background="#EE1A1A2E"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource ColorBtnStyle}" Background="#EFF44336" Click="BtnColor_Click" Tag="Red" ToolTipService.ToolTip="红色"/>
                <Button Style="{StaticResource ColorBtnStyle}" Background="#FFFFEB3B" Click="BtnColor_Click" Tag="Yellow" ToolTipService.ToolTip="黄色"/>
                <Button Style="{StaticResource ColorBtnStyle}" Background="#EF4CAF50" Click="BtnColor_Click" Tag="Green" ToolTipService.ToolTip="绿色"/>
                <Button Style="{StaticResource ColorBtnStyle}" Background="#EF2196F3" Click="BtnColor_Click" Tag="Blue" ToolTipService.ToolTip="蓝色"/>
                <Button Style="{StaticResource ColorBtnStyle}" Background="#FFFFFFFF" Click="BtnColor_Click" Tag="White" ToolTipService.ToolTip="白色"/>
                <Button Style="{StaticResource ColorBtnStyle}" Background="#EF000000" Click="BtnColor_Click" Tag="Black" ToolTipService.ToolTip="黑色"/>
                <!-- 线宽选择 -->
                <Border Width="1" Background="#44FFFFFF" Margin="4,0"/>
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnThin_Click" ToolTipService.ToolTip="细线">
                    <Ellipse Width="6" Height="6" Fill="White"/>
                </Button>
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnMedium_Click" ToolTipService.ToolTip="中线">
                    <Ellipse Width="10" Height="10" Fill="White"/>
                </Button>
                <Button Style="{StaticResource CircleToolBtnStyle}" Click="BtnThick_Click" ToolTipService.ToolTip="粗线">
                    <Ellipse Width="15" Height="15" Fill="White"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ 加载中覆盖层 ══ -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="60" Height="60" Foreground="White"/>
                <TextBlock x:Name="LoadingText" Text="正在加载幻灯片..." Foreground="White"
                           FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══ 欢迎/空状态覆盖层 ══ -->
        <Grid x:Name="WelcomeOverlay" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xEA86;" FontSize="80" Foreground="#44FFFFFF"/>
                <TextBlock Text="RimePPT" Foreground="#88FFFFFF" FontSize="28" FontWeight="Light"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="点击右下角文件夹图标打开 .pptx 文件" Foreground="#66FFFFFF"
                           FontSize="14" HorizontalAlignment="Center"/>
                <Button x:Name="BtnWelcomeOpen"
                        Content="打开 PPT 文件"
                        HorizontalAlignment="Center"
                        Padding="24,10"
                        CornerRadius="20"
                        Background="#331565C0"
                        Foreground="White"
                        BorderBrush="#441565C0"
                        Click="BtnOpenFile_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
